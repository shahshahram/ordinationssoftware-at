# ============================================
# Ordinationssoftware - Backend .env (Hetzner / mymedicloud.at)
# Kopieren nach: backend/.env auf dem Server
# ============================================

NODE_ENV=production
PORT=5001

# MongoDB (ohne Auth für Test; für Produktion authSource hinzufügen)
MONGODB_URI=mongodb://localhost:27017/ordinationssoftware

# JWT - WICHTIG: Auf dem Server neu generieren!
# Befehl 1: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Befehl 2: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Die beiden Ausgaben als JWT_SECRET und JWT_REFRESH_SECRET eintragen
JWT_SECRET=HIER_32_ZEICHEN_HEX_EINFUEGEN
JWT_REFRESH_SECRET=HIER_32_ZEICHEN_HEX_EINFUEGEN
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Domain - bereits für mymedicloud.at gesetzt
FRONTEND_URL=https://mymedicloud.at

# Initial Admin (nur bei leerer DB beim ersten Start)
INITIAL_ADMIN_EMAIL=admin@praxis.local
INITIAL_ADMIN_PASSWORD=StarkesPasswort123!

# Datei-Uploads
UPLOAD_PATH=/home/ordinationssoftware/ordinationssoftware-at/backend/uploads
MAX_FILE_SIZE=10485760

# Backup
BACKUP_PATH=/home/ordinationssoftware/backups
BACKUP_RETENTION_DAYS=30

# Logging
LOG_LEVEL=info
LOG_DIR=/home/ordinationssoftware/logs
