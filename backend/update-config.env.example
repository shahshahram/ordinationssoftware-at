# ============================================
# Update-Konfiguration für automatische Updates
# ============================================
# 
# Kopieren Sie diese Datei nach .env und passen Sie die Werte an
# 
# WICHTIG: Die URLs müssen von der ÖGK-Website ermittelt werden!
# Die aktuellen URLs können sich ändern.

# ============================================
# Honorarordnungen URLs
# ============================================
# 
# WICHTIG: In Österreich gibt es unterschiedliche Honorarordnungen je nach
# Versicherungsträger und möglicherweise nach Bundesland!
# 
# ÖGK: Honorarordnungen sind oft nach Bundesländern getrennt
# BVAEB & SVS: Haben eigene Honorarordnungen
# GOÄ: Wird von der Österreichischen Ärztekammer veröffentlicht
#
# ============================================
# ÖGK Tarifdatenbank URLs
# ============================================

# KHO (Kassenhonorarordnung) - XML Format
# ⚠️ WICHTIG: In Österreich gibt es KEINEN EBM (Einheitlicher Bewertungsmaßstab) wie in Deutschland!
# KHO ist das österreichische Äquivalent zum deutschen EBM.
# 
# Quelle: https://www.gesundheitskasse.at
# Bereich: "Vertragspartner" (NICHT "Tarifsystem"!)
# 
# WICHTIG: ÖGK-Honorarordnungen sind oft nach Bundesländern getrennt!
# Stellen Sie sicher, dass Sie die richtige Version für Ihr Bundesland verwenden.
# 
# Aktuelle URL ermitteln:
# 1. Besuchen Sie: https://www.gesundheitskasse.at
# 2. Navigieren Sie zu: "Vertragspartner" oder "Für Ärzte"
# 3. Suchen Sie nach: "Honorarordnung", "KHO", "Kassenhonorarordnung"
# 4. Wählen Sie ggf. Ihr Bundesland aus
# 5. Kopieren Sie die Download-URL
#
# Suchbegriffe: "KHO", "Kassenhonorarordnung", "Leistungskatalog", "Honorarordnung", "Vertragspartner"
OGK_EBM_XML_URL=https://www.gesundheitskasse.at/cdscontent/load?contentid=10008.784932&version=1704786268

# KHO - CSV Format (Alternative)
# Hinweis: "EBM" im Variablennamen ist historisch bedingt - eigentlich ist KHO gemeint
OGK_EBM_CSV_URL=https://www.gesundheitskasse.at/cdscontent/load?contentid=10008.784932&version=1704786268&format=csv

# ============================================
# Weitere Versicherungsträger (optional)
# ============================================
# 
# BVAEB und SVS haben eigene Honorarordnungen, die separat heruntergeladen werden müssen.
# Diese können über die jeweiligen Websites oder über die Ärztekammer bezogen werden.
#
# BVAEB (Versicherungsanstalt für Eisenbahnen und Bergbau)
# Quelle: https://www.bvaeb.at oder über Ärztekammer
# BVAEB_HONORARORDNUNG_URL=https://www.bvaeb.at/.../honorarordnung.xml
#
# SVS (Sozialversicherung der Selbständigen)
# Quelle: https://www.svs.at oder über Ärztekammer
# SVS_HONORARORDNUNG_URL=https://www.svs.at/.../honorarordnung.xml
#
# Weitere: KFA, PVA, VAEB, AUVA haben ebenfalls eigene Honorarordnungen

# KHO (Kassenhonorarordnung) - XML Format
# Quelle: https://www.gesundheitskasse.at/cdscontent/
# Aktuelle URL ermitteln unter: https://www.gesundheitskasse.at/cdscontent/load?contentid=10008.784932
OGK_KHO_XML_URL=https://www.gesundheitskasse.at/cdscontent/load?contentid=10008.784932&version=1704786268

# KHO - CSV Format (Alternative)
OGK_KHO_CSV_URL=https://www.gesundheitskasse.at/cdscontent/load?contentid=10008.784932&version=1704786268&format=csv

# GOÄ (Gebührenordnung für Ärzte) - XML Format
# WICHTIG: Diese URL muss von der ÖGK-Website ermittelt werden!
# Die aktuelle URL ist ein Platzhalter und muss aktualisiert werden!
# Quelle: https://www.gesundheitskasse.at/cdscontent/
OGK_GOAE_XML_URL=https://www.gesundheitskasse.at/cdscontent/load?contentid=10008.1234569&version=1

# GOÄ - CSV Format (Alternative)
OGK_GOAE_CSV_URL=https://www.gesundheitskasse.at/cdscontent/load?contentid=10008.1234569&version=1&format=csv

# ============================================
# Cache-Konfiguration
# ============================================

# Verzeichnis für heruntergeladene Tarifdatenbanken
# Standard: ./cache/tariffs
OGK_TARIFF_CACHE_DIR=./cache/tariffs

# ============================================
# Update-Zeitpläne (können in server.js angepasst werden)
# ============================================
# 
# Wöchentliches ServiceCatalog-Preis-Update: Montags um 4:00 Uhr
# Monatliches Tarif-Update: 1. des Monats um 5:00 Uhr
# Jährliches Service-Katalog Update: 1. Januar um 2:00 Uhr
#
# Diese Zeitpläne sind in backend/server.js hardcodiert.
# Für Anpassungen siehe: backend/server.js (Zeilen 426-462)

